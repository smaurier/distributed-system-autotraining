{
  "name": "distributed-systems-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Oracles exécutables des labs Systèmes distribués (règle : un lab = un geste métier complet). Résilience prouvée par de vrais tests de panne, jamais supposée.",
  "type": "module",
  "scripts": {
    "lab:01": "vitest run --root lab-01-appel-externe-resilient",
